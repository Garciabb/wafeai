# ============================================================
# WAFEAI — Variables de entorno (EJEMPLO — no usar en prod)
# Copiar a .env y NUNCA subir .env a git
# ============================================================

# Base de datos
DATABASE_URL=sqlite:///./wafeai.db
# En producción usar PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/wafeai_db

# JWT — generar con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CAMBIAR_POR_CLAVE_ALEATORIA_256_BITS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Modo debug — FALSE en producción (oculta /docs y /redoc)
DEBUG=True

# Email (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=WafeAI <notificaciones@wafeai.co>

# WhatsApp Business API (Meta)
WHATSAPP_TOKEN=EAA_token_aqui
WHATSAPP_PHONE_ID=phone_id_aqui
WHATSAPP_API_VERSION=v21.0

# Supabase (si aplica)
SUPABASE_KEY=sbp_xxxxxxxxxxxxxxxx

# Frontend
FRONTEND_URL=http://localhost:5173
